# =============================================================================
# TTRPG Platform - Unified Environment Configuration
# =============================================================================
# Copy this to .env and fill in ALL values before deployment.
# Also create a separate .env.prod for production overrides.
# Suggested split:
#   - .env: local/dev defaults (localhost URLs, test services, debug flags)
#   - .env.prod: production-only overrides (public URLs, real IPs, TURN creds)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 
#      to generate secure secrets.
# =============================================================================

# ========== FILE TARGETS ==========
# .env (local/dev):
#   - NODE_ENV=development
#   - FRONTEND_URL=http://localhost:5173
#   - VITE_API_URL=http://localhost:5000/api
#   - CORS_ALLOWED_ORIGINS=http://localhost:5173
#   - MEDIASOUP_ANNOUNCED_IP=127.0.0.1
#   - TURN_ENABLED=false (optional for local)
#
# .env.prod (production overrides):
#   - NODE_ENV=production
#   - FRONTEND_URL=https://app.example.com
#   - VITE_API_URL=https://app.example.com/api
#   - CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   - MEDIASOUP_ANNOUNCED_IP=<public-server-ip>
#   - TURN_ENABLED=true

# ========== DATABASE CONFIGURATION ==========
# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_postgres_password_min_16_chars
POSTGRES_DB=ttrpg_db

# Connection string (inside Docker network)
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:change_me_secure_postgres_password_min_16_chars@db:5432/ttrpg_db?schema=public

# Test database connection string (for integration tests)
# Uses separate test database on port 5433
DATABASE_URL_TEST=postgresql://testuser:testpass@localhost:5433/ttrpg_test?schema=public
POSTGRES_TEST_USER=testuser
POSTGRES_TEST_PASSWORD=testpass
POSTGRES_TEST_DB=ttrpg_test

# Test Redis connection string (for integration tests)
# Uses separate test Redis on port 6380
REDIS_URL_TEST=redis://localhost:6380

# ========== SERVER CONFIGURATION ==========
# Port inside and outside Docker
SERVER_PORT=5000
PORT=5000  # Alias for compatibility

# Environment mode
NODE_ENV=production

# Database migrations
RUN_MIGRATIONS=true

# Proxy settings (trust X-Forwarded-* headers)
TRUST_PROXY=1

# Home next-relevant tuning:
# Max age for ACTIVE session before treating it as stale (hours)
HOME_ACTIVE_MAX_AGE_HOURS=24
# Grace window for near-past PLANNED session before switching to next session (minutes)
HOME_PLANNED_TOLERANCE_MINUTES=2

# ========== FRONTEND CONFIGURATION ==========
# Public URL where frontend is accessible
FRONTEND_URL=https://app.example.com

# Client port
CLIENT_PORT=5173

# Vite API endpoint (used by frontend to call backend)
VITE_API_URL=https://app.example.com/api

# ========== SECURITY & CSRF ==========
# Allowed CORS origins (comma-separated)
# Production: use HTTPS domains only
# Development: can use http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# JWT signing secret (generate unique, min 32 chars)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_generate_secure_jwt_secret_min_32_chars

# Cookie signing secret (generate unique, min 32 chars, DIFFERENT from JWT_SECRET)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me_generate_secure_cookie_secret_min_32_chars

# Share token secret for campaign link generation (generate unique, min 32 chars)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_TOKEN_SECRET=change_me_generate_secure_share_token_secret_min_32_chars

# ========== REDIS CONFIGURATION ==========
# Redis URL for in-memory state (deleted users blacklist, rate limiting)
# Inside Docker network, use the service name
REDIS_URL=redis://ttrpg_redis:6379

# ========== DEBUG & DEVELOPMENT ==========
# Expose password reset token in API responses (NEVER enable in production)
# Only for local development to test forgot-password flow
EXPOSE_AUTH_DEBUG_TOKENS=false

# Admin database UI (opt-in via: docker compose --profile debug up)
ADMINER_PORT=8080

# ========== EMAIL SERVICE (PASSWORD RESET) ==========
# Provider: "gmail" or "smtp"
EMAIL_PROVIDER=smtp

# Gmail configuration (if using provider=gmail)
# ⚠️  Use App Password, NOT your actual Gmail password!
# Generate at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-app-specific-password

# SMTP server configuration (if using provider=smtp)
# Recommended: use Gmail SMTP for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email sender address (no-reply mail)
EMAIL_FROM=noreply@ttrpg.com

# ========== MAINTENANCE ==========
# Cleanup expired tokens (cron format: minute hour day month day-of-week)
# Default: every day at 02:00
TOKEN_CLEANUP_SCHEDULE=0 2 * * *

# ========== WEBRTC / CALL ==========
# Окремий WebSocket шлях для дзвінків (не змінює /ws/chat)
WS_CALL_PATH=/ws/call

# ========== MEDIASOUP ==========
# IP, на якому mediasoup worker слухає WebRTC транспорти
# Docker/production: 0.0.0.0 | локально: 127.0.0.1
MEDIASOUP_LISTEN_IP=0.0.0.0

# Зовнішній IP сервера, який оголошується клієнтам у ICE candidates
# ОБОВ'ЯЗКОВО змінити на реальний IP у production (наприклад, 167.172.111.89)
MEDIASOUP_ANNOUNCED_IP=167.172.111.89

# Діапазон UDP портів для RTC транспортів
# ОБОВ'ЯЗКОВО відкрити на firewall / DigitalOcean Firewall Rules
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# ========== TURN (coturn на production сервері) ==========
# true - увімкнути TURN у ICE конфіг клієнта
# Production: true (обов'язково для NAT traversal)
TURN_ENABLED=true

# TURN сервер URL (coturn слухає на порту 3478)
# Production: turn:167.172.111.89:3478
TURN_URL=turn:167.172.111.89:3478
    
# TURN credentials (статичні для MVP)
# Задаються в /etc/turnserver.conf на сервері через turnadmin
TURN_USERNAME=ttrpg_turn_user
TURN_PASSWORD=change_me_secure_turn_password

# Транспорт для TURN: udp або tcp
TURN_TRANSPORT=udp
