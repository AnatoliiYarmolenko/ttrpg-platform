# =============================================================================
# TTRPG Platform - Уніфікована конфігурація середовища
# =============================================================================
# Скопіюйте це в .env і заповніть УСІ значення перед деплоєм.
# Також створіть окремий .env.prod для production-override'ів.
# Рекомендований поділ:
#   - .env: локальні/дев налаштування (localhost URL, тестові сервіси, debug-прапорці)
#   - .env.prod: production-override'и (публічні URL, реальні IP, TURN-дані)
# Використайте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#      щоб згенерувати безпечні секрети.
# =============================================================================

# ========== ПРИЗНАЧЕННЯ ФАЙЛІВ ==========
# .env (local/dev):
#   - NODE_ENV=development
#   - FRONTEND_URL=http://localhost:5173
#   - VITE_API_URL=http://localhost:5000/api
#   - CORS_ALLOWED_ORIGINS=http://localhost:5173
#   - MEDIASOUP_ANNOUNCED_IP=127.0.0.1
#   - TURN_ENABLED=false (необов'язково локально)
#
# .env.prod (production-override'и):
#   - NODE_ENV=production
#   - FRONTEND_URL=https://app.example.com
#   - VITE_API_URL=https://app.example.com/api
#   - CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   - MEDIASOUP_ANNOUNCED_IP=<public-server-ip>
#   - TURN_ENABLED=true

# ========== КОНФІГУРАЦІЯ БАЗИ ДАНИХ ==========
# Облікові дані PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_postgres_password_min_16_chars
POSTGRES_DB=ttrpg_db

# Рядок підключення (всередині Docker-мережі)
# Формат: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:change_me_secure_postgres_password_min_16_chars@db:5432/ttrpg_db?schema=public

# Рядок підключення до тестової БД (для інтеграційних тестів)
# Використовує окрему тестову БД на порту 5433
DATABASE_URL_TEST=postgresql://testuser:testpass@localhost:5433/ttrpg_test?schema=public
POSTGRES_TEST_USER=testuser
POSTGRES_TEST_PASSWORD=testpass
POSTGRES_TEST_DB=ttrpg_test

# Рядок підключення до тестового Redis (для інтеграційних тестів)
# Використовує окремий тестовий Redis на порту 6380
REDIS_URL_TEST=redis://localhost:6380

# ========== КОНФІГУРАЦІЯ СЕРВЕРА ==========
# Порт всередині та зовні Docker
SERVER_PORT=5000
PORT=5000  # Alias for compatibility

# Режим середовища
NODE_ENV=production

# Увімкнути dev auth (для локальної розробки та тестування API)
ENABLE_DEV_AUTH=false

# Міграції БД
RUN_MIGRATIONS=true

# Налаштування проксі (довіряти заголовкам X-Forwarded-*)
TRUST_PROXY=1

# Налаштування релевантності для Home:
# Макс. вік ACTIVE-сесії перед визнанням застарілою (години)
HOME_ACTIVE_MAX_AGE_HOURS=24
# Допуск для нещодавньої PLANNED-сесії перед переходом на наступну (хвилини)
HOME_PLANNED_TOLERANCE_MINUTES=2

# ========== КОНФІГУРАЦІЯ ФРОНТЕНДУ ==========
# Публічний URL, де доступний фронтенд
FRONTEND_URL=https://app.example.com

# Порт клієнта
CLIENT_PORT=5173

# Vite API endpoint (використовується фронтендом для виклику бекенду)
VITE_API_URL=https://app.example.com/api

# ========== БЕЗПЕКА & CSRF ==========
# Дозволені CORS-origin (через кому)
# Production: лише HTTPS домени
# Development: можна http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Секрет підпису JWT (згенеруйте унікальний, мін. 32 символи)
# команда: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_generate_secure_jwt_secret_min_32_chars

# Секрет підпису cookie (згенеруйте унікальний, мін. 32 символи, ВІДМІННИЙ від JWT_SECRET)
# команда: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me_generate_secure_cookie_secret_min_32_chars

# Секрет токена для генерації посилань кампаній (згенеруйте унікальний, мін. 32 символи)
# Ротація приводить до негайної недійсності всіх існуючих share-посилань, тому змінюйте лише у разі компрометації.
# команда: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_TOKEN_SECRET=change_me_generate_secure_share_token_secret_min_32_chars

# ========== КОНФІГУРАЦІЯ REDIS ==========
# Пароль для Redis
# команда: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASSWORD=supersecret_redis_password_change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@ttrpg_redis:6379

# ========== DEBUG & DEVELOPMENT ==========
# Показувати токен скидання пароля у відповідях API (НІКОЛИ не вмикати у production)
# Лише для локальної розробки, щоб тестувати forgot-password flow
EXPOSE_AUTH_DEBUG_TOKENS=false

# Адмін-інтерфейс БД (увімкнення через: docker compose --profile debug up)
ADMINER_PORT=8080

# ========== EMAIL СЕРВІС (СКИДАННЯ ПАРОЛЯ) ==========
# Провайдер: "gmail" або "smtp"
EMAIL_PROVIDER=smtp

# Налаштування Gmail (якщо provider=gmail)
# ⚠️  Використовуйте App Password, НЕ ваш реальний пароль Gmail!
# Згенерувати тут: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-app-specific-password

# Налаштування SMTP-сервера (якщо provider=smtp)
# Рекомендовано: використовувати Gmail SMTP у production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Адреса відправника (no-reply)
EMAIL_FROM=noreply@ttrpg.com

# ========== ОБСЛУГОВУВАННЯ ==========
# Очищення прострочених токенів (cron-формат: хвилина година день місяць день-тижня)
# За замовчуванням: щодня о 02:00
TOKEN_CLEANUP_SCHEDULE=0 2 * * *

# ========== WEBRTC / CALL ==========
# Окремий WebSocket шлях для дзвінків (не змінює /ws/chat)
WS_CALL_PATH=/ws/call

# ========== MEDIASOUP ==========
# IP, на якому mediasoup worker слухає WebRTC транспорти
# Docker/production: 0.0.0.0 | локально: 127.0.0.1
MEDIASOUP_LISTEN_IP=0.0.0.0

# Зовнішній IP сервера, який оголошується клієнтам у ICE candidates
# ОБОВ'ЯЗКОВО змінити на реальний IP у production
MEDIASOUP_ANNOUNCED_IP=change_me_public_server_ip

# Діапазон UDP портів для RTC транспортів
# ОБОВ'ЯЗКОВО відкрити на firewall / DigitalOcean Firewall Rules
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# ========== TURN (coturn на production сервері) ==========
# true - увімкнути TURN у ICE конфіг клієнта
# Production: true (обов'язково для NAT traversal)
TURN_ENABLED=true

# TURN сервер URL (coturn слухає на порту 3478)
# Production: turn:167.172.111.89:3478
TURN_URL=turn:167.172.111.89:3478
    
TURN_REALM=myttrpg.me
TURN_SHARED_SECRET=change_me_generate_secure_share_token_secret_min_32_chars

# Транспорт для TURN: udp або tcp
TURN_TRANSPORT=udp
