# =============================================================================
# TTRPG Client - Local Development Environment
# =============================================================================
# This file is for LOCAL development (npm run dev).
# Vite automatically loads .env.local and .env files.
# Copy this to client/.env.local and customize.
# =============================================================================

# Backend API endpoint (used by frontend to call server)
# For development with Docker: http://localhost:5000/api
# For development locally: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
