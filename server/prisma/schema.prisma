generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  username                String                   @unique
  password                String
  role                    UserRole                 @default(USER)
  avatarUrl               String?
  displayName             String?
  bio                     String?
  timezone                String?
  language                String?                  @default("uk")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastActiveAt            DateTime?
  isDeleted               Boolean                  @default(false)
  passwordResetToken      String?                  @unique
  passwordResetExpiry     DateTime?
  telegramChatId          String?
  telegramLinkedAt        DateTime?
  wallet                  Wallet?
  stats                   UserStats?
  campaignsOwned          Campaign[]               @relation("OwnerCampaigns")
  campaignMembers         CampaignMember[]
  sessionsJoined          SessionParticipant[]
  ownedSessions           Session[]                @relation("OwnedSessions")
  joinRequests            JoinRequest[]
  reviewedJoinRequests    JoinRequest[]            @relation("ReviewedBy")
  messages                ChatMessage[]
  emailVerified           Boolean                  @default(false)
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens       EmailChangeToken[]
  notifications           NotificationRecipient[]
  notificationPreference  NotificationPreference?
}

model Wallet {
  id           Int           @id @default(autoincrement())
  balance      Float         @default(0.0)
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model UserStats {
  id             Int  @id @default(autoincrement())
  hoursPlayed    Int  @default(0)
  sessionsPlayed Int  @default(0)
  userId         Int  @unique
  user           User @relation(fields: [userId], references: [id])
}

model Campaign {
  id                 Int                @id @default(autoincrement())
  title              String
  description        String?
  imageUrl           String?
  system             String?
  status             CampaignStatus     @default(ACTIVE)
  visibility         CampaignVisibility @default(LINK_ONLY)
  shareTokenHash     String?            @unique
  shareTokenEncrypted String?
  shareTokenCreatedAt DateTime?
  ownerId            Int
  owner              User               @relation("OwnerCampaigns", fields: [ownerId], references: [id])
  members            CampaignMember[]
  sessions           Session[]
  joinRequests       JoinRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum CampaignStatus {
  ACTIVE
  FINISHED
}

enum CampaignVisibility {
  PUBLIC
  LINK_ONLY
}

model CampaignMember {
  id         Int          @id @default(autoincrement())
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())
  userId     Int
  user       User         @relation(fields: [userId], references: [id])
  campaignId Int
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
}

enum CampaignRole {
  OWNER
  GM
  PLAYER
}

model Session {
  id                  Int               @id @default(autoincrement())
  title               String
  description         String?
  date                DateTime
  duration            Int               @default(180)
  status              SessionStatus     @default(PLANNED)
  visibility          SessionVisibility @default(PRIVATE)
  shareTokenHash      String?           @unique
  shareTokenEncrypted String?
  shareTokenCreatedAt DateTime?
  price               Float             @default(0.0)
  maxPlayers          Int               @default(4)
  system              String?
  campaignId          Int?
  campaign            Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ownerId             Int
  owner               User              @relation("OwnedSessions", fields: [ownerId], references: [id])
  participants        SessionParticipant[]
  messages            ChatMessage[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([date, system])
  @@index([status])
  @@index([campaignId])
}

enum SessionVisibility {
  PUBLIC
  PRIVATE
  LINK_ONLY
}

model SessionParticipant {
  id        Int               @id @default(autoincrement())
  role      SessionRole       @default(PLAYER)
  status    ParticipantStatus @default(PENDING)
  isGuest   Boolean           @default(false)
  userId    Int
  sessionId Int
  user      User              @relation(fields: [userId], references: [id])
  session   Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

enum SessionRole {
  GM
  PLAYER
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model JoinRequest {
  id         Int               @id @default(autoincrement())
  status     JoinRequestStatus @default(PENDING)
  message    String?
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  campaignId Int
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?
  reviewedBy Int?
  reviewer   User?             @relation("ReviewedBy", fields: [reviewedBy], references: [id])

  @@unique([userId, campaignId])
  @@index([campaignId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailChangeToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Transaction {
  id       Int      @id @default(autoincrement())
  amount   Float
  type     String
  date     DateTime @default(now())
  walletId Int
  wallet   Wallet   @relation(fields: [walletId], references: [id])
}

enum SessionStatus {
  PLANNED
  ACTIVE
  FINISHED
  CANCELED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
  SECURITY
}

enum RecipientStatus {
  ACTIVE
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Notification {
  id                Int                     @id @default(autoincrement())
  eventKey          String
  type              String
  severity          NotificationSeverity
  category          String
  title             String
  body              String
  link              String?
  metadata          Json?
  dedupeKey         String?
  aggregationKey    String?
  expiresAt         DateTime?
  source            String?
  createdAt         DateTime                @default(now())

  recipients        NotificationRecipient[]
  outboxEvents      OutboxEvent[]

  @@index([createdAt])
  @@index([eventKey])
  @@index([type])
  @@index([dedupeKey])
  @@index([aggregationKey])
}

model NotificationRecipient {
  id                Int                @id @default(autoincrement())
  notificationId    Int
  userId            Int
  status            RecipientStatus    @default(ACTIVE)
  readAt            DateTime?
  archivedAt        DateTime?
  channelsDelivered Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  enabledChannels Json
  mutedCategories Json?
  mutedSeverities Json?
  quietHoursStart Int?
  quietHoursEnd   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id             Int          @id @default(autoincrement())
  notificationId Int?
  type           String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  nextRunAt      DateTime     @default(now())
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  notification Notification?  @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  deliveries     DeliveryAttempt[]

  @@index([status, nextRunAt])
}

model DeliveryAttempt {
  id          Int      @id @default(autoincrement())
  outboxId    Int
  channel     String
  status      String
  error       String?
  attemptedAt DateTime @default(now())

  outbox OutboxEvent @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId, channel])
}
