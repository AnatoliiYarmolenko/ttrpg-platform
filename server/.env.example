# =============================================================================
# TTRPG Server - Local Development Environment
# =============================================================================
# This file is for LOCAL development (npm run dev without Docker).
# For Docker deployment, use the root .env file instead.
# Copy this to server/.env and customize values.
# =============================================================================

# ========== REDIS CONFIGURATION ==========
# Redis URL for in-memory state (deleted users blacklist, rate limiting)
# Default: local Redis on port 6379
REDIS_URL=redis://localhost:6379

# ========== DATABASE CONFIGURATION ==========
# For local development, usually runs on localhost
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ttrpg_db?schema=public

# ========== SERVER CONFIGURATION ==========
# Server port (optional, defaults to 5000)
PORT=5000

# Environment mode (development, production, test)
NODE_ENV=development

# Frontend URL (for CORS origin fallback)
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
# For development: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Home next-relevant tuning:
# Max age for ACTIVE session before treating it as stale (hours)
HOME_ACTIVE_MAX_AGE_HOURS=24
# Grace window for near-past PLANNED session before switching to next session (minutes)
HOME_PLANNED_TOLERANCE_MINUTES=2

# ========== SECURITY & CSRF ==========
# JWT signing secret (generate unique, min 32 chars)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev_jwt_secret_generate_unique_min_32_chars

# Cookie signing secret (generate unique, min 32 chars, DIFFERENT from JWT_SECRET)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=dev_cookie_secret_generate_unique_min_32_chars

# Share token secret for campaign link generation (generate unique, min 32 chars)
# command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_TOKEN_SECRET=dev_share_token_secret_generate_unique_min_32_chars

# ========== DEBUG & DEVELOPMENT ==========
# Expose password reset token in API responses (safe only in development)
EXPOSE_AUTH_DEBUG_TOKENS=true

# ========== EMAIL SERVICE (PASSWORD RESET) ==========
# For development: use Gmail with App Password
EMAIL_PROVIDER=gmail

# Gmail configuration
# ⚠️  Use App Password, NOT your actual Gmail password!
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-specific-password

# Email sender address
EMAIL_FROM=noreply@ttrpg.local

# ========== MAINTENANCE ==========
# Cleanup expired tokens (cron format: minute hour day month day-of-week)
# Default: every day at 02:00
TOKEN_CLEANUP_SCHEDULE=0 2 * * *