{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "node scripts/lint.js",
    "pretest": "prisma generate --schema=prisma/schema.prisma",
    "test": "node --test tests/unit/**/*.test.js",
    "pretest:coverage": "prisma generate --schema=prisma/schema.prisma",
    "test:coverage": "c8 --all --include=src/**/*.js --exclude=src/constants/** --exclude=src/validation/** --reporter=text-summary --reporter=lcov --reporter=html node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "docker compose --profile test up -d db_test redis_test && DATABASE_URL='postgresql://testuser:testpass@localhost:5433/ttrpg_test?schema=public' npx prisma db push --skip-generate && DATABASE_URL='postgresql://testuser:testpass@localhost:5433/ttrpg_test?schema=public' REDIS_URL='redis://localhost:6380' node --test tests/integration/**/*.test.js",
    "test:integration:cleanup": "docker compose rm -f -s db_test redis_test",
    "dev": "nodemon index.js",
    "seed": "docker exec -it ttrpg_server node prisma/seed.js",
    "seed:local": "prisma db seed",
    "clear-rate-limits": "node scripts/clear-rate-limits.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^11.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.1"
  }
}
